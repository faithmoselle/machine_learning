# ============================================================================
# EXAMPLE 1: HOURS STUDIED vs EXAM SCORE
# ============================================================================
print("=" * 60)
print("EXAMPLE 1: Predicting Exam Score from Study Hours")
print("=" * 60)

import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression

# Step 1: Prepare the Dataset
# Independent variable (Hours studied - must be 2D array for sklearn)
X_study = np.array([1, 2, 3, 4.5, 5, 6, 7.5, 8, 9, 10]).reshape(-1, 1)
# Dependent variable (Exam scores)
y_score = np.array([35, 40, 50, 55, 65, 70, 79, 85, 88, 95])

# Step 2: Create and Train the Model
model_study = LinearRegression()
model_study.fit(X_study, y_score)

# Display the regression equation: y = mx + b
slope_study = model_study.coef_[0]
intercept_study = model_study.intercept_
print(f"Equation: Exam Score = {slope_study:.2f} × Hours + {intercept_study:.2f}")

# Step 3: Make Predictions
hours_to_predict = 7
predicted_score = model_study.predict([[hours_to_predict]])
print(f"Predicted exam score for {hours_to_predict} hours of study: {predicted_score[0]:.2f}")

# Step 4: Visualize the Results
plt.figure(figsize=(8, 5))
plt.scatter(X_study, y_score, color="blue", label="Actual Data", s=50)
plt.plot(X_study, model_study.predict(X_study), color="red", label="Regression Line", linewidth=2)
plt.xlabel("Hours Studied")
plt.ylabel("Exam Score")
plt.title("Linear Regression: Hours Studied vs Exam Score")
plt.legend()
plt.grid(alpha=0.3)
plt.show()

# ============================================================================
# EXAMPLE 2: EXERCISE TIME vs CALORIES BURNED
# ============================================================================
print("\n" + "=" * 60)
print("EXAMPLE 2: Predicting Calories Burned from Exercise Time")
print("=" * 60)

# Step 1: Prepare the Dataset
# Independent variable (Exercise time in hours)
X_exercise = np.array([1, 2, 3, 4.5, 5, 6, 7.5, 8, 9, 10]).reshape(-1, 1)
# Dependent variable (Calories burned)
y_calories = np.array([8, 9, 11, 12, 13, 14, 19, 26, 27, 30])

# Step 2: Create and Train the Model
model_exercise = LinearRegression()
model_exercise.fit(X_exercise, y_calories)

# Display the regression equation
slope_exercise = model_exercise.coef_[0]
intercept_exercise = model_exercise.intercept_
print(f"Equation: Calories Burned = {slope_exercise:.2f} × Hours + {intercept_exercise:.2f}")

# Step 3: Make Predictions
hours_to_predict = 2
predicted_calories = model_exercise.predict([[hours_to_predict]])
print(f"Predicted calories burned for {hours_to_predict} hours of exercise: {predicted_calories[0]:.2f}")

# Step 4: Visualize the Results
plt.figure(figsize=(8, 5))
plt.scatter(X_exercise, y_calories, color="blue", label="Actual Data", s=50)
plt.plot(X_exercise, model_exercise.predict(X_exercise), color="red", label="Regression Line", linewidth=2)
plt.xlabel("Exercise Time (hours)")
plt.ylabel("Calories Burned")
plt.title("Linear Regression: Exercise Time vs Calories Burned")
plt.legend()
plt.grid(alpha=0.3)
plt.show()

# ============================================================================
# MODEL COMPARISON SUMMARY
